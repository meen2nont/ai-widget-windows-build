# ── Required ──────────────────────────────────────────
# Strong random secret for encrypting API keys at rest.
# Generate one with: openssl rand -hex 32
CONFIG_SECRET=your-strong-random-secret-here

# ── Optional ─────────────────────────────────────────
# Server port (default: 9000)
PORT=9000

# Data directory for SQLite database + config (default: ./data)
DATA_DIR=./data

# Set to "0" to prevent server from starting (for testing)
START_SERVER=1

# Node environment (production / development)
NODE_ENV=development

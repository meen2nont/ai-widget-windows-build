<UserControl x:Class="AIWidgetWindowsApp.Views.OllamaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="NeutralProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#1AFFFFFF" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="#99FFFFFF" CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ComboBox ItemsSource="{Binding CloudModels}" 
                  SelectedItem="{Binding SelectedOllamaModel, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Name"
                  Margin="0,0,0,10"/>
                  
        <!-- Session Usage Bar -->
        <TextBlock Text="Session usage" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
        <ProgressBar Style="{StaticResource NeutralProgressBar}" 
                     Value="{Binding SessionUsagePercent}" Maximum="100" 
                     Height="6" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding SessionUsagePercent, StringFormat={}{0}% used}" Foreground="White" FontSize="10" HorizontalAlignment="Right" Margin="0,-15,0,10"/>
        
        <!-- Weekly Usage Bar -->
        <TextBlock Text="Weekly usage" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
        <ProgressBar Style="{StaticResource NeutralProgressBar}" 
                     Value="{Binding WeeklyUsagePercent}" Maximum="100" 
                     Height="6" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding WeeklyUsagePercent, StringFormat={}{0}% used}" Foreground="White" FontSize="10" HorizontalAlignment="Right" Margin="0,-15,0,10"/>
        
        <TextBox Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}" 
                 Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                 Background="#2D2D2D" Foreground="White" BorderThickness="0"
                 Margin="0,0,0,10" Padding="5"/>
                 
        <Button Content="Send" Command="{Binding SendCommand}" 
                Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0"
                HorizontalAlignment="Right" Margin="0,0,0,10"/>
                
        <ScrollViewer Height="80">
            <TextBlock Text="{Binding AiResponse}" Foreground="White" TextWrapping="Wrap"/>
        </ScrollViewer>
    </StackPanel>
</UserControl>

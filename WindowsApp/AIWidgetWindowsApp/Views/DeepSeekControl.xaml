<UserControl x:Class="AIWidgetWindowsApp.Views.DeepSeekControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIWidgetWindowsApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Balance: " Foreground="LightGray"/>
            <TextBlock Text="{Binding Balance}" Foreground="White" FontWeight="Bold"/>
            <TextBlock Text=" " Foreground="White" />
            <TextBlock Text="{Binding Currency}" Foreground="White"/>
        </StackPanel>

        <TextBox Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}" 
                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                 Background="#2D2D2D" Foreground="White" BorderThickness="0"
                 Margin="0,0,0,10" Padding="5"/>
                 
        <Button Content="Send" Command="{Binding SendCommand}" 
                Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0"
                HorizontalAlignment="Right" Margin="0,0,0,20"/>
                
        <TextBlock Text="Response:" Foreground="LightGray" Margin="0,0,0,5"/>
        <ScrollViewer Height="120">
            <TextBlock Text="{Binding AiResponse}" Foreground="White" TextWrapping="Wrap"/>
        </ScrollViewer>
        
        <Button Content="Copy" Command="{Binding CopyToClipboardCommand}" 
                Background="#333333" Foreground="White" Padding="10,5" BorderThickness="0"
                HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>

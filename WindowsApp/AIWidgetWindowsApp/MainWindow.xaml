<Window x:Class="AIWidgetWindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIWidgetWindowsApp"
        xmlns:views="clr-namespace:AIWidgetWindowsApp.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="AI Widget" Height="500" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    
    <tb:TaskbarIcon
        x:Name="MyNotifyIcon"
        IconSource="/deepseek_favicon.ico"
        ToolTipText="AI Widget">
        
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Show" Click="MenuItemShow_Click"/>
                <MenuItem Header="Exit" Click="MenuItemExit_Click"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

    <Border Background="#1E1E1E" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="AI Widget Dashboard" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Tabs -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                <Button Content="Overview" Tag="0" Click="TabButton_Click" Background="{Binding SelectedTab0Bg}" Foreground="{Binding SelectedTab0Fg}" BorderThickness="0" Padding="5"/>
                <Button Content="DeepSeek" Tag="1" Click="TabButton_Click" Background="{Binding SelectedTab1Bg}" Foreground="{Binding SelectedTab1Fg}" BorderThickness="0" Padding="5"/>
                <Button Content="Ollama"   Tag="2" Click="TabButton_Click" Background="{Binding SelectedTab2Bg}" Foreground="{Binding SelectedTab2Fg}" BorderThickness="0" Padding="5"/>
                <Button Content="Pay"      Tag="3" Click="TabButton_Click" Background="{Binding SelectedTab3Bg}" Foreground="{Binding SelectedTab3Fg}" BorderThickness="0" Padding="5"/>
            </UniformGrid>

            <!-- Content Area -->
            <ContentControl Grid.Row="2" x:Name="MainContentControl" />
        </Grid>
    </Border>
</Window>
